{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",

  "Storage": {
    "Provider": "Mongo",
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "irrigacao_config"
  },

  "Projects": [
    {
      "ProjectId": "irrig001",
      "ClaimCode": "TROQUE-ESTE-CODIGO",
      "OrionEntityId": "urn:ngsi-ld:Irrigation:001",
      "OrionEntityType": "Irrigation"
    }
  ],

  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 45
  },

  "Orion": {
    "Enabled": false,
    "BaseUrl": "http://localhost:1026",
    "FiwareService": "smart",
    "FiwareServicePath": "/",
    "AttributePrefix": "cfg"
  },

  "Security": {
    "ServiceApiKey": "",
    "DashboardOrigins": [ "http://localhost:5173" ]
  },

  "DataProtection": {
    "KeysPath": "keys"
  }
}
